# dTRINITY Ethereum Contracts Environment Variables
# Copy this file to .env and fill in your values

# Mainnet deployer — set exactly ONE of these (names match typescript/hardhat/named-accounts.ts)
# Must derive to the address in manifests/ethereum-mainnet-roles.json (deployer field)
MNEMONIC_MAINNET_DEPLOYER=your_twelve_word_mnemonic_here
PK_MAINNET_DEPLOYER=

# Sepolia deployer (optional)
MNEMONIC_TESTNET_DEPLOYER=your_testnet_mnemonic_here
PK_TESTNET_DEPLOYER=

# RPC (optional — comment out or omit; never use KEY= with an empty value)
# ALCHEMY_API_KEY=your_alchemy_api_key_here
# ETHEREUM_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/...
# ETHEREUM_TESTNET_RPC_URL=https://...

# Etherscan API key (contract verification only)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Safe Protocol Configuration
USE_SAFE=false

# Enable IR compilation for all contracts (slower but avoids stack too deep errors)
VIA_IR=false
